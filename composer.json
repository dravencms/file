{
  "name": "dravencms/file",
  "type": "dravencms-package",
  "description": "File module for dravencms",
  "keywords": [
    "dravencms",
    "file"
  ],
  "license": [
    "LGPL-3.0-only"
  ],
  "authors": [
    {
      "name": "Adam Schubert"
    }
  ],
  "require": {
    "salamek/nette-files": "^3.1",
    "dravencms/locale": "^2.1",
    "dravencms/admin": "^3.4",
    "dravencms/application": "^0.3",
    "dravencms/packager": "^3.0"
  },
  "require-dev": {
    "nette/tester": "@dev"
  },
  "autoload": {
    "psr-0": {
      "Dravencms\\": "src/"
    }
  },
  "suggest": {
    "dravencms/structure": "Allows file components to be used in cms"
  },
  "extra": {
    "dravencms": {
      "configuration": "dravencms.config.neon",
      "assets": {
        "public": "%wwwDir%/assets/file"
      }
    }
  },
  "conflict": {
    "dravencms/user": "<3.1",
    "dravencms/admin": "<3.4",
    "dravencms/gallery": "<3.1",
    "dravencms/article": "<3.1",
    "dravencms/partner": "<3.1",
    "dravencms/carousel": "<3.1"
  },
  "scripts": {
    "build:assets": "build-public-assets"
  }
}

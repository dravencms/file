{var $selectionMode = $selectionMode ?? false}
<div n:class="filemanager, $selectionMode ? filemanager-select">
    <ol class="breadcrumb mb-3">
        <li class="breadcrumb-item"><a n:href="File:" class="folder" data-structureid="" aria-label="{_'file.fileManager'}"><i class="fa fa-home" aria-hidden="true"></i></a></li>
        <li n:foreach="$structureInfo as $info" n:class="breadcrumb-item, $iterator->isLast() ? active">
            <a n:href="File: $info->getId()" class="folder" data-structureid="{$info->getId()}">{$info->getName()}</a>
        </li>
    </ol>
    <ul class="files">
        <li n:if="$parentStructure" class="file back" data-backid="{$parentStructure->getParent()?->getId()}">
            <figure>
                <a n:href="File: $parentStructure->getParent()?->getId()" class="file-tile-link link">
                    <span class="file-preview"><i class="fa fa-level-up file-folder-icon" aria-hidden="true"></i></span>
                    <span class="file-name"><span class="file-name-text">{_'file.back'}</span></span>
                </a>
            </figure>
        </li>
        <li n:foreach="$directories as $dir" class="file folder" data-structureid="{$dir->getId()}">
            <figure>
                <a n:href="File: $dir->getId()" class="file-tile-link link" title="{$dir->getName()}">
                    <span class="file-preview"><i class="fa fa-folder file-folder-icon" aria-hidden="true"></i></span>
                    <span class="file-name"><span class="file-name-text">{$dir->getName()}</span></span>
                </a>
                <figcaption class="file-actions">
                    <a n:href="File:ajaxStructureInfo $dir->getId()" class="btn btn-sm btn-icon btn-outline-secondary info" data-bs-toggle="modal" data-bs-target="#fileManagerModal" title="{_'file.info'}" aria-label="{_'file.info'}"><i class="fa fa-info" aria-hidden="true"></i></a>
                    <a n:href="structureDownload! $dir->getId()" class="btn btn-sm btn-icon btn-outline-secondary download" title="{_'file.download'}" aria-label="{_'file.download'}"><i class="fa fa-download" aria-hidden="true"></i></a>
                    <a n:href="File:ajaxStructureForm, structureId => $dir->getId()" class="btn btn-sm btn-icon btn-outline-secondary rename" data-bs-toggle="modal" data-bs-target="#fileManagerModal" title="{_'file.rename'}" aria-label="{_'file.rename'}"><i class="fa fa-pencil" aria-hidden="true"></i></a>
                    <a n:href="structureDelete! $dir->getId()" class="btn btn-sm btn-icon btn-outline-danger delete" data-confirm="{_'file.areYouSureYouWantTodeleteThisFolder'}" title="{_'file.delete'}" aria-label="{_'file.delete'}"><i class="fa fa-trash" aria-hidden="true"></i></a>
                </figcaption>
            </figure>
        </li>
        {foreach $structureFiles as $structureFile}
            {include 'ajaxFileUploadUpdate.latte', structureFile => $structureFile}
        {/foreach}
        <li n:if="!count($directories) && !count($structureFiles)" class="filemanager-empty text-secondary">{_'file.emptyFolder'}</li>
    </ul>
</div>

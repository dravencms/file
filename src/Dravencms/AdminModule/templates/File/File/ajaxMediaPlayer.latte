<div id="jp_container_1" class="jp-video jp-video-360p" role="application" aria-label="{_'file.media.player'}">
    <div class="jp-type-single">
        <div id="jquery_jplayer_1" class="jp-jplayer"></div>
        <div class="jp-gui">
            <div class="jp-video-play">
                <button class="jp-video-play-icon" role="button" tabindex="0">{_'file.media.play'}</button>
            </div>
            <div class="jp-interface">
                <div class="jp-progress">
                    <div class="jp-seek-bar">
                        <div class="jp-play-bar"></div>
                    </div>
                </div>
                <div class="jp-current-time" role="timer" aria-label="{_'file.media.time'}">&nbsp;</div>
                <div class="jp-duration" role="timer" aria-label="{_'file.media.duration'}">&nbsp;</div>
                <div class="jp-controls-holder">
                    <div class="jp-controls">
                        <button class="jp-play" role="button" tabindex="0">{_'file.media.play'}</button>
                        <button class="jp-stop" role="button" tabindex="0">{_'file.media.stop'}</button>
                    </div>
                    <div class="jp-volume-controls">
                        <button class="jp-mute" role="button" tabindex="0">{_'file.media.mute'}</button>
                        <button class="jp-volume-max" role="button" tabindex="0">{_'file.media.maximumVolume'}</button>
                        <div class="jp-volume-bar">
                            <div class="jp-volume-bar-value"></div>
                        </div>
                    </div>
                    <div class="jp-toggles">
                        <button class="jp-repeat" role="button" tabindex="0">{_'file.media.repeat'}</button>
                        <button class="jp-full-screen" role="button" tabindex="0">{_'file.media.fullscreen'}</button>
                    </div>
                </div>
                <div class="jp-details">
                    <div class="jp-title" aria-label="{_'file.media.title'}">&nbsp;</div>
                </div>
            </div>
        </div>
        <div class="jp-no-solution">
            <span>{_'file.media.unsupportedTitle'}</span>
            {_'file.media.unsupported'}
        </div>
    </div>
</div>

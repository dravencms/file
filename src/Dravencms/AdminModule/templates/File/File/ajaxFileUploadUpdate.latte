{var $file = $structureFile->getFile()}
{var $fileName = $structureFile->getName().'.'.$file->getExtension()}
{var $fileUrl = $basePath.'/data/'.substr($file->getSum(), 0, 2).'/'.$file->getBasename()}
<li class="file fileitem"
    data-filesid="{$structureFile->getId()}"
    data-filespath="{$fileUrl}"
    data-filestype="{$file->getType()}"
    data-filesname="{$fileName}">
    <figure>
        {if $file->getType() === \Dravencms\Model\File\Entities\File::TYPE_IMAGE}
            <a href="{img $file, '1024x'}" class="file-tile-link link" data-gallery title="{$fileName}">
        {elseif $file->getType() === \Dravencms\Model\File\Entities\File::TYPE_MEDIA}
            <a href="{$fileUrl}" class="file-tile-link link" type="{$file->getMimeType()}" data-poster="{fileIcon $file}" data-sources="{json_encode([['href' => $fileUrl, 'type' => $file->getMimeType()]], \JSON_THROW_ON_ERROR)}" data-gallery title="{$fileName}">
        {else}
            <a n:href="fileDownload! $structureFile->getId()" class="file-tile-link link" title="{$fileName}">
        {/if}
            <span class="file-preview">
                {if $file->getType() === \Dravencms\Model\File\Entities\File::TYPE_IMAGE}
                    <img alt="" class="file-image" loading="lazy" n:img="$file, '200x'">
                {else}
                    <img alt="" loading="lazy" n:fileIcon="$file">
                {/if}
            </span>
            <span class="file-name"><span class="file-name-text">{$fileName}</span></span>
        </a>
        <figcaption class="file-actions">
            <a n:href="File:ajaxFileInfo $structureFile->getId()" class="btn btn-sm btn-icon btn-outline-secondary info" data-bs-toggle="modal" data-bs-target="#fileManagerModal" title="{_'file.info'}" aria-label="{_'file.info'}"><i class="fa fa-info" aria-hidden="true"></i></a>
            <a n:href="fileDownload! $structureFile->getId()" class="btn btn-sm btn-icon btn-outline-secondary download" title="{_'file.download'}" aria-label="{_'file.download'}"><i class="fa fa-download" aria-hidden="true"></i></a>
            <a n:href="File:ajaxStructureFileForm $structureFile->getId()" class="btn btn-sm btn-icon btn-outline-secondary rename" data-bs-toggle="modal" data-bs-target="#fileManagerModal" title="{_'file.rename'}" aria-label="{_'file.rename'}"><i class="fa fa-pencil" aria-hidden="true"></i></a>
            <a n:href="fileDelete! $structureFile->getId()" class="btn btn-sm btn-icon btn-outline-danger delete" data-confirm="{_'file.areYouSureYouWantTodeleteThisFile'}" title="{_'file.delete'}" aria-label="{_'file.delete'}"><i class="fa fa-trash" aria-hidden="true"></i></a>
        </figcaption>
    </figure>
</li>

{block #content}
    <section class="file-manager-page">
    <p>
        <a n:href="File:ajaxStructureForm parentStructureId => ($parentStructure ? $parentStructure->getId() : null)" class="btn btn-info" data-bs-toggle="modal" data-bs-target="#fileManagerModal"><i class="fa fa-folder-open"></i> {_"file.newFolder"}</a>
    </p>

    {control formUpload}

    {include 'ajaxFileManager.latte', 'structureInfo'=> $structureInfo, 'parentStructure' => $parentStructure, 'directories' => $directories, 'structureFiles' => $structureFiles}


    {define #js}
        <script>
            $(function () {
                // Now that the DOM is fully loaded, create the dropzone, and setup the
                // event listeners
                var myDropzone = new Dropzone('#' + {$presenter['formUpload']['form']->getElementPrototype()->id});
                myDropzone.on("success", function (file, response) {
                    $("<div>").load({link File:ajaxFileUploadUpdate 'filesStructureFilesId' => '666'}.replace('666', response.filesStructureFilesId), function () {
                        var newItem = $($(this).html());
                        $(".file-manager-page > .filemanager > .files > .filemanager-empty").remove();
                        $(".file-manager-page > .filemanager > .files").append(newItem);
                    }
                    )
                    ;
                    /* Maybe display some more file information on your page */
                });
            });
        </script>
    {/define}
    <!-- Modal -->
    <div class="modal fade" id="fileManagerModal" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
            </div>
        </div>
    </div>
    </section>

{/block}

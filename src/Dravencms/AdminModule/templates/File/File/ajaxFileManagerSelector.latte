<div class="modal-header">
    <h4 class="modal-title" id="myModalLabel">{_"file.selectFile"}...</h4>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{_"file.close"}"></button>
</div>
<div class="modal-body">
    {include 'ajaxFileManager.latte', structureInfo => $structureInfo, parentStructure => $parentStructure, directories => $directories, structureFiles => $structureFiles, selectionMode => true}
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">{_"file.close"}</button>
</div>
